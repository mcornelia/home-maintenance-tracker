{
  "name": "yard-tracker",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development node --watch --import tsx server/index.ts",
    "build": "vite build && node --import tsx scripts/build-server.ts",
    "start": "NODE_ENV=production node --env-file=.env dist/index.js",
    "check": "tsc --noEmit",
    "check:public": "node --import tsx scripts/check-public-boundary.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx server/db/migrate.ts",
    "macos:install": "zsh scripts/macos/install-launch-agent.zsh",
    "macos:status": "zsh scripts/macos/status-launch-agent.zsh",
    "macos:uninstall": "zsh scripts/macos/uninstall-launch-agent.zsh"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.90.2",
    "@trpc/client": "^11.6.0",
    "@trpc/react-query": "^11.6.0",
    "@trpc/server": "^11.6.0",
    "archiver": "^7.0.1",
    "better-sqlite3": "^13.0.1",
    "cookie": "^1.0.2",
    "drizzle-orm": "^0.44.5",
    "express": "^4.21.2",
    "multer": "^2.2.0",
    "nanoid": "^5.1.5",
    "nodemailer": "^9.0.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sharp": "^0.35.3",
    "superjson": "^1.13.3",
    "wouter": "^3.7.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.7.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.1",
    "typescript": "5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.6"
  },
  "packageManager": "pnpm@11.9.0"
}
