# Copy this file to .env, replace the example path, and keep the file private.
# Node reads it directly in production; shell quoting is not required.

# The directory holding SQLite, uploads, and local operational state.
# Use an absolute path. Do not use the repository directory for a real household.
YARD_TRACKER_DATA_DIR=/absolute/path/to/yard-tracker-data

# Docker Compose host paths. These defaults remain private and gitignored.
YARD_TRACKER_HOST_DATA_DIR=./local-data
YARD_TRACKER_HOST_BACKUP_DIR=./local-backups
YARD_TRACKER_HOST_PORT=4173

# LAN bind settings.
HOST=0.0.0.0
PORT=4173

# Used for date-only schedule calculations.
TZ=America/New_York

# SMTP is optional. Household recipients and cadence are configured in the app.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Yard Tracker <yard-tracker@example.com>
